{
  "name": "aihot-desk",
  "version": "0.2.1",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "description": "AI 热点信号台 —— 托盘常驻，实时接收 AIHOT 的中文 AI 资讯：热点榜、精选流、每日简报",
  "author": "tomcato",
  "main": "./out/main/index.js",
  "scripts": {
    "gen:icons": "node scripts/gen-icons.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test:core": "tsc -p tsconfig.test.json && node .tmp-test/scripts/core-test.js",
    "dist": "electron-vite build && node scripts/dist.mjs --win --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
